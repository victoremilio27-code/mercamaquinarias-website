#!/bin/bash
# Despliegue de MercaMaquinarias.
#
# Lo unico que el usuario `deploy` puede ejecutar como root, y lo unico
# que GitHub Actions puede hacer en esta maquina: su llave lleva la
# orden forzada en authorized_keys, asi que aunque se filtrara no
# serviria para nada mas.
#
# Si el sitio no responde despues de actualizar, se vuelve solo a la
# version anterior. Es la diferencia entre "el despliegue fallo" y "el
# sitio esta caido y hay que entrar a arreglarlo", que es justo lo que
# este montaje existe para evitar.
set -euo pipefail

REPO=/var/www/mercamaquinarias
DUENO=mercamaquinarias
SERVICIO=mercamaquinarias
SALUD=http://127.0.0.1:8080/
INTENTOS=15

cd "$REPO"

comoDueno() { sudo -u "$DUENO" "$@"; }
version() { comoDueno git log --oneline -1; }

# El repositorio tiene que ser de quien lo usa. Si alguien entra al
# servidor y hace un `git pull` como root, git escribe objetos nuevos
# con dueno root y a partir de ahi el despliegue falla con
# "insufficient permission for adding an object". Paso una vez, con 82
# archivos y 15 subcarpetas de .git/objects en manos de root.
#
# Se corrige en cada despliegue en vez de avisar: el sentido de todo
# esto es no tener que entrar al servidor a arreglar nada. Es
# idempotente y no toca ni la base ni los secretos, que viven fuera.
chown -R "$DUENO:$DUENO" "$REPO"

ANTES=$(comoDueno git rev-parse HEAD)

comoDueno git fetch --quiet origin main
NUEVO=$(comoDueno git rev-parse origin/main)

if [ "$ANTES" = "$NUEVO" ]; then
  echo "Ya estaba al dia: $(version)"
  exit 0
fi

echo "Actualizando de ${ANTES:0:7} a ${NUEVO:0:7}"

# --ff-only a proposito: si alguien commiteo a mano en el servidor, es
# preferible que el despliegue falle a que se fusione a ciegas.
comoDueno git merge --ff-only origin/main

# #73. Las migraciones se aplican solas al arrancar y la vuelta atras de
# abajo devuelve el codigo, no la base. Si el codigo nuevo trae
# migraciones que la base no tiene, se respalda ANTES de reiniciar
# (VACUUM INTO + integrity_check, en $RESPALDOS/antes-de-migrar/, los
# ultimos 5). Antes lo hacia Victor a mano por SSH en cada fusion.
#
# Si el respaldo falla, no se reinicia: el proceso que corre sigue con
# el codigo viejo en memoria, y se devuelven los archivos para que el
# siguiente arranque no aplique nada sin respaldo. Las rutas son las de
# deploy/mercamaquinarias.service y deploy/mercamaquinarias-tareas.service.
BASE=/var/lib/mercamaquinarias/mercamaquinarias.db
RESPALDOS=/var/backups/mercamaquinarias
if ! comoDueno env MERCA_DB="$BASE" MERCA_RESPALDOS="$RESPALDOS" \
     node --no-warnings tools/respaldo-antes-de-migrar.js; then
  echo "ERROR: no se pudo respaldar la base antes de migrar. Volviendo a ${ANTES:0:7} sin reiniciar" >&2
  comoDueno git reset --hard "$ANTES"
  exit 1
fi

systemctl restart "$SERVICIO"

# #66 (#147). La conciliacion de pagos con tarjeta cada 10 minutos.
# Antes habia que instalarla a mano y nadie lo hizo: un aviso de CardNet
# perdido en un reinicio dejaba el pago pendiente para siempre. Se copian
# las dos unidades solo si cambiaron (cmp), y se activa el temporizador.
# Con MERCA_CARDNET sin fijar la tarea sale con 0 sin llamar a nadie, asi
# que activarla antes de encender CardNet es inocuo.
#
# Va DESPUES de comprobar que el sitio responde y no lo tumba: si falla,
# el sitio nuevo ya esta arriba y solo se avisa.
UNIDADES=/etc/systemd/system
instalarTemporizadorPagos() {
  local cambio=0 u
  for u in mercamaquinarias-pagos.service mercamaquinarias-pagos.timer; do
    if ! cmp -s "$REPO/deploy/$u" "$UNIDADES/$u"; then
      install -m 644 "$REPO/deploy/$u" "$UNIDADES/$u" || return 1
      cambio=1
    fi
  done
  if [ "$cambio" = 1 ]; then systemctl daemon-reload || return 1; fi
  systemctl enable --now mercamaquinarias-pagos.timer >/dev/null 2>&1 || return 1
}

# Se espera a que levante en vez de dormir una cantidad fija: arrancar
# tarda distinto segun lo que haya que migrar en la base.
for _ in $(seq 1 "$INTENTOS"); do
  sleep 1
  if curl -fsS -o /dev/null --max-time 3 "$SALUD"; then
    echo "Sitio arriba: $(version)"
    if instalarTemporizadorPagos; then
      echo "Conciliacion de pagos: mercamaquinarias-pagos.timer activo"
    else
      echo "AVISO: no se pudo instalar mercamaquinarias-pagos.timer (el sitio sigue arriba)" >&2
    fi
    exit 0
  fi
done

echo "ERROR: el sitio no respondio en ${INTENTOS}s. Volviendo a ${ANTES:0:7}" >&2
comoDueno git reset --hard "$ANTES"
systemctl restart "$SERVICIO"

for _ in $(seq 1 "$INTENTOS"); do
  sleep 1
  if curl -fsS -o /dev/null --max-time 3 "$SALUD"; then
    echo "Restaurada la version anterior. El sitio esta arriba: $(version)" >&2
    exit 1
  fi
done

echo "ATENCION: ni la version anterior responde. Hace falta mirar el servidor." >&2
exit 1
