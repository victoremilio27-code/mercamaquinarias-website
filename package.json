{
  "name": "mercamaquinarias",
  "version": "1.0.0",
  "description": "Página de aterrizaje de MercaMaquinarias, marketplace de maquinaria y equipo pesado.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node tools/serve.js --port 8080",
    "shot": "node tools/screenshot.js --url http://127.0.0.1:8080/",
    "shot:fold": "node tools/screenshot.js --url http://127.0.0.1:8080/ --width 1440 --clip",
    "check": "node tools/check-links.js",
    "check:encoding": "node tools/fix-encoding.js --check",
    "check:motion": "node tools/check-motion.js",
    "check:contraste": "node tools/check-contraste.js",
    "favicon": "node tools/make-favicon.js",
    "db:reset": "node -e \"require('fs').readdirSync('db').filter(f=>f.startsWith('mercamaquinarias.db')).forEach(f=>require('fs').rmSync('db/'+f))\"",
    "db:demo": "node tools/seed.js",
    "db:demo:limpiar": "node tools/seed.js --vaciar",
    "auditar": "node tools/verificar-taxonomia.js && node tools/auditar-publico.js && node tools/auditar-flujos.js && node tools/auditar-permisos.js && node tools/check-contraste.js",
    "auditar:publico": "node tools/auditar-publico.js",
    "auditar:flujos": "node tools/auditar-flujos.js",
    "auditar:permisos": "node tools/auditar-permisos.js",
    "tareas": "node tools/tareas.js",
    "tareas:seco": "node tools/tareas.js --seco",
    "respaldo": "node tools/tareas.js respaldo",
    "correo:probar": "node tools/probar-correo.js",
    "seguridad:probar": "node tools/probar-seguridad.js",
    "chat:probar": "node tools/prueba-chat.js",
    "facturas:probar": "node tools/probar-facturas.js",
    "pagos:probar": "node tools/probar-pagos.js",
    "facturas:letras": "node --test tools/numero-a-letras.prueba.js",
    "facturas:secuencias": "node tools/facturas.js secuencias",
    "dealer:probar": "node tools/probar-pagina-dealer.js",
    "db:flota": "node tools/seed.js --solo-flota",
    "taxonomia": "node tools/verificar-taxonomia.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "puppeteer": "^25.4.0"
  }
}
