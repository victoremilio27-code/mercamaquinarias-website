{
  "name": "mercamaquinarias",
  "version": "1.0.0",
  "description": "Página de aterrizaje de MercaMaquinarias, marketplace de maquinaria y equipo pesado.",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node tools/serve.js --port 8080",
    "shot": "node tools/screenshot.js --url http://127.0.0.1:8080/",
    "shot:fold": "node tools/screenshot.js --url http://127.0.0.1:8080/ --width 1440 --clip",
    "check": "node tools/check-links.js",
    "check:encoding": "node tools/fix-encoding.js --check",
    "check:motion": "node tools/check-motion.js",
    "check:contraste": "node tools/check-contraste.js",
    "favicon": "node tools/make-favicon.js",
    "db:reset": "node -e \"require('fs').readdirSync('db').filter(f=>f.startsWith('mercamaquinarias.db')).forEach(f=>require('fs').rmSync('db/'+f))\"",
    "db:demo": "node tools/seed.js",
    "db:demo:limpiar": "node tools/seed.js --vaciar",
    "auditar": "node tools/verificar-taxonomia.js && node tools/auditar-publico.js && node tools/auditar-flujos.js && node tools/auditar-permisos.js && node tools/auditar-metricas.js && node tools/auditar-telefono.js && node tools/check-contraste.js",
    "auditar:publico": "node tools/auditar-publico.js",
    "auditar:flujos": "node tools/auditar-flujos.js",
    "auditar:permisos": "node tools/auditar-permisos.js",
    "auditar:metricas": "node tools/auditar-metricas.js",
    "auditar:telefono": "node tools/auditar-telefono.js",
    "tareas": "node tools/tareas.js",
    "tareas:seco": "node tools/tareas.js --seco",
    "respaldo": "node tools/tareas.js respaldo",
    "respaldo:probar": "node tools/probar-respaldo.js",
    "correo:probar": "node tools/probar-correo.js",
    "seguridad:probar": "node tools/probar-seguridad.js",
    "chat:probar": "node tools/prueba-chat.js",
    "facturas:probar": "node tools/probar-facturas.js",
    "pagos:probar": "node tools/probar-pagos.js",
    "medios:puro": "node --test tools/medios.prueba.js",
    "transferencia:probar": "node tools/probar-transferencia.js",
    "publicacion:probar": "node tools/probar-publicacion.js",
    "pdf:puro": "node --test tools/pdf.prueba.js",
    "renovacion:probar": "node tools/probar-renovacion.js",
    "recordatorios:probar": "node tools/probar-recordatorios.js",
    "entorno:puro": "node --test tools/entorno.prueba.js",
    "capacidad:probar": "node tools/probar-capacidad.js",
    "cardnet:probar": "node tools/probar-cardnet.js",
    "facturas:letras": "node --test tools/numero-a-letras.prueba.js",
    "meta:probar": "node tools/probar-meta.js",
    "precios:probar": "node --test tools/precios.prueba.js",
    "lote:puro": "node --test tools/lote.prueba.js",
    "reglas:puro": "node --test tools/reglas.prueba.js",
    "alertas:puro": "node --test tools/alertas.prueba.js",
    "busquedas-api:probar": "node tools/probar-busquedas-api.js",
    "alertas:tarea": "node tools/probar-alertas-tarea.js",
    "rango:puro": "node --test tools/rango.prueba.js",
    "f607:puro": "node --test tools/formato607.prueba.js",
    "especificaciones:puro": "node --test tools/especificaciones.prueba.js",
    "mapa:puro": "node --test tools/mapa.prueba.js",
    "especificaciones:probar": "node tools/probar-especificaciones.js",
    "lote:probar": "node tools/probar-lote.js",
    "paquete:probar": "node tools/probar-paquete.js",
    "servicios:probar": "node --test tools/servicios.prueba.js",
    "facturas:secuencias": "node tools/facturas.js secuencias",
    "dealer:probar": "node tools/probar-pagina-dealer.js",
    "bitacora:probar": "node tools/probar-bitacora.js",
    "cuenta:probar": "node tools/probar-cuenta.js",
    "busquedas:probar": "node tools/probar-busquedas.js",
    "telefono:probar": "node tools/probar-telefono.js",
    "metricas:probar": "node tools/probar-metricas.js",
    "contactos:probar": "node tools/probar-contactos.js",
    "catalogo:probar": "node tools/probar-catalogo.js",
    "db:flota": "node tools/seed.js --solo-flota",
    "taxonomia": "node tools/verificar-taxonomia.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "puppeteer": "^25.4.0"
  }
}
